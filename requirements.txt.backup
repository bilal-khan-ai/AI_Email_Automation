# --- PII / Presidio ---
# spaCy does NOT reliably install on Python 3.13 yet; require <=3.12. as of Feb 2026.
spacy==3.7.5; python_version < "3.13"
presidio-analyzer==2.2.355; python_version < "3.13"
presidio-anonymizer==2.2.355; python_version < "3.13"

# spaCy English model (only for Python <3.13)
en-core-web-sm @ https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.7.1/en_core_web_sm-3.7.1-py3-none-any.whl ; python_version < "3.13"
