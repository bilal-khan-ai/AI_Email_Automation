# requirements.txt (Windows-friendly, pinned)
#
# IMPORTANT:
# - This project currently DOES NOT install cleanly on Python 3.13 because spaCy/Presidio
#   (and some of their compiled deps) don't have reliable cp313 wheels yet and will fall back
#   to building from source (needs Visual Studio Build Tools). Prefer Python 3.12.x.
#
# Recommended: Python 3.12.x (or 3.11.x) + venv.
#
# --- Core web app ---
Flask==3.0.3
Flask-Session==0.6.0
Flask-SocketIO==5.3.6
python-socketio==5.11.2
eventlet==0.35.2

requests==2.32.3
python-dotenv==1.2.1
beautifulsoup4==4.12.3

# lxml often tries to compile on Windows if you pin an older version.
# Use a newer version that publishes wheels for newer Python versions.
lxml==5.3.2

